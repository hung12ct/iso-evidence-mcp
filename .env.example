# Notion internal integration token (https://www.notion.so/my-integrations)
# Share the target page with the integration: page ... share ... add your integration.
NOTION_TOKEN=secret_xxx

# Optional: pin the Notion API version (default below).
NOTION_VERSION=2022-06-28

# Optional: where the saved browser login session is stored.
# Default: ~/.config/iso-evidence-mcp/session.json
# ISO_EVIDENCE_SESSION=/absolute/path/to/session.json
